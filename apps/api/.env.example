# ---------------------------------------------------------------- Core
NODE_ENV=development
PORT=4000

# ---------------------------------------------------------------- Database
# Lokal via infra/docker-compose.yml
DATABASE_URL=postgresql://careloop:careloop@localhost:5432/careloop?schema=public
# Koneksi langsung (non-pooler) untuk `prisma migrate` — diperlukan di Supabase.
DIRECT_URL=
# Database integration test. WAJIB berbeda dari DATABASE_URL (suite melakukan TRUNCATE).
# Kosongkan untuk melewati integration test.
TEST_DATABASE_URL=postgresql://careloop:careloop@localhost:5432/careloop_test?schema=public

# ---------------------------------------------------------------- Queue & cache
# Opsional saat demo offline.
REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------- Auth
JWT_SECRET=ganti-dengan-string-acak-minimal-32-karakter
JWT_EXPIRES_IN=24h
DATA_ENCRYPTION_KEY=

# ---------------------------------------------------------------- Integrasi keluar
# mock = tidak ada panggilan keluar (default demo). live = wajib isi kredensial WhatsApp di bawah.
PROVIDER_MODE=mock
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WA_WEBHOOK_VERIFY_TOKEN=
# Secret aplikasi Meta untuk verifikasi signature webhook.
WA_APP_SECRET=

# ---------------------------------------------------------------- HTTP
# Whitelist origin frontend, dipisah koma. Kosong = izinkan semua (hanya non-production).
CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW=1 minute

# ---------------------------------------------------------------- Waktu
# Backend menyimpan UTC; offset ini hanya default tampilan pasien (WIB).
TZ_OFFSET=+07:00

# ---------------------------------------------------------------- Timeout eskalasi (detik)
# Default mengikuti docs/PRD.md FR-3.1, FR-4.3, FR-7.2.
ESCALATION_PATIENT_WAIT_SEC=1800
ESCALATION_FAMILY_TIER1_WAIT_SEC=900
ESCALATION_FAMILY_TIER2_WAIT_SEC=900
ESCALATION_NAKES_WAIT_SEC=1800
# Konfirmasi pasien saat anomali darurat — spesifikasi PRD 30–60 detik.
EMERGENCY_PATIENT_CONFIRM_SEC=45
COMPLIANCE_DEFER_MINUTES=15

# ---------------------------------------------------------------- Aturan anomali HR (FR-4.2)
ANOMALY_HR_MIN=50
ANOMALY_HR_MAX=120
ANOMALY_WINDOW_SEC=60
