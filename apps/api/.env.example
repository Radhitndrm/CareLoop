# ---------------------------------------------------------------- Core
NODE_ENV=development
PORT=4000

# ---------------------------------------------------------------- Database
# Lokal via infra/docker-compose.yml
DATABASE_URL=postgresql://careloop:careloop@localhost:5432/careloop?schema=public
# Koneksi langsung (non-pooler) untuk `prisma migrate` — WAJIB di Supabase.
#   staging/production: postgresql://USER:PASSWORD@db.<ref>.supabase.co:5432/postgres
DIRECT_URL=
# Database integration test. WAJIB berbeda dari DATABASE_URL (suite melakukan TRUNCATE).
# Kosongkan untuk melewati integration test.
TEST_DATABASE_URL=postgresql://careloop:careloop@localhost:5432/careloop_test?schema=public

# Catatan Supabase: DATABASE_URL (runtime) boleh memakai connection pooler
# transaction mode (port 6543) dengan `?pgbouncer=true&connection_limit=<n>`.
# DIRECT_URL tetap harus port 5432 — DDL tidak jalan di atas PgBouncer.

# ---------------------------------------------------------------- Queue & cache
# Wajib di production: env validation menolak startup tanpa ini (queue in-process
# hilang saat restart). Hosted Redis TLS memakai skema `rediss://`.
#   lokal : redis://localhost:6380
#   cloud : rediss://default:<password>@<host>:6379
REDIS_URL=redis://localhost:6380

# ---------------------------------------------------------------- Auth
JWT_SECRET=ganti-dengan-string-acak-minimal-32-karakter
JWT_EXPIRES_IN=24h
DATA_ENCRYPTION_KEY=

# ---------------------------------------------------------------- OTP login pasien
# Batas dari docs/API.md §2: 1 permintaan per 30 detik, maksimal 5 percobaan verifikasi.
OTP_TTL_SEC=300
OTP_RESEND_COOLDOWN_SEC=30
OTP_MAX_ATTEMPTS=5
# Dipakai hanya saat PROVIDER_MODE=mock.
OTP_MOCK_CODE=123456

# ---------------------------------------------------------------- Integrasi keluar
# mock = tidak ada panggilan keluar (default demo). live = wajib isi kredensial WhatsApp di bawah.
PROVIDER_MODE=mock
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WA_WEBHOOK_VERIFY_TOKEN=
# Secret aplikasi Meta untuk verifikasi signature webhook.
WA_APP_SECRET=

# ---------------------------------------------------------------- HTTP
# Whitelist origin frontend, dipisah koma. Kosong = izinkan semua (hanya non-production).
CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW=1 minute

# ---------------------------------------------------------------- Waktu
# Backend menyimpan UTC; offset ini hanya default tampilan pasien (WIB).
TZ_OFFSET=+07:00

# ---------------------------------------------------------------- Timeout eskalasi (detik)
# Default mengikuti docs/PRD.md FR-3.1, FR-4.3, FR-7.2.
ESCALATION_PATIENT_WAIT_SEC=1800
ESCALATION_FAMILY_TIER1_WAIT_SEC=900
ESCALATION_FAMILY_TIER2_WAIT_SEC=900
ESCALATION_NAKES_WAIT_SEC=1800
# Konfirmasi pasien saat anomali darurat — spesifikasi PRD 30–60 detik.
EMERGENCY_PATIENT_CONFIRM_SEC=45
COMPLIANCE_DEFER_MINUTES=15
# Batas terlambat konfirmasi yang masih diterima (menit). Lewat ini → 422, tidak dicatat.
COMPLIANCE_CONFIRM_MAX_LATE_MINUTES=1440

# ---------------------------------------------------------------- Aturan anomali HR (FR-4.2)
ANOMALY_HR_MIN=50
ANOMALY_HR_MAX=120
ANOMALY_WINDOW_SEC=60

# ---------------------------------------------------------------- alur farmasi (docs/API.md §3.6)
# Seberapa awal (hari) permintaan rutin dibuat sebelum tanggal ambil.
PHARMACY_REFILL_LEAD_DAYS=3
# Jatah hari per pengambilan bila dokter tidak mengisi medications.daysSupply.
PHARMACY_DEFAULT_DAYS_SUPPLY=30
# Batas atas jumlah hari yang boleh diminta / diserahkan dalam satu kali.
PHARMACY_MAX_DAYS_SUPPLY=90
