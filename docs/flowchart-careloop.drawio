  <diagram id="careloop-pharmacy" name="5. Farmasi &amp; Refill Obat">
    <mxGraphModel dx="1500" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1350" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p5_title" value="CareLoop — Alur Farmasi: Permintaan Refill Obat → Penyerahan" style="text;html=1;fontSize=20;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="320" y="8" width="620" height="30" as="geometry" />
        </mxCell>
        <mxCell id="p5_g1" value="SUMBER PERMINTAAN" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#666666;dashed=1;verticalAlign=top;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="40" y="50" width="360" height="800" as="geometry" />
        </mxCell>
        <mxCell id="p5_g2" value="DOKTER / BIDAN (keputusan klinis)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#6c8ebf;dashed=1;verticalAlign=top;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="440" y="50" width="300" height="980" as="geometry" />
        </mxCell>
        <mxCell id="p5_g3" value="FARMASI (persiapan &amp; penyerahan)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#82b366;dashed=1;verticalAlign=top;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="780" y="50" width="580" height="1250" as="geometry" />
        </mxCell>
        <mxCell id="p5_r1" value="SUMBER ROUTINE — scheduler harian&#10;(pharmacy-routine-scheduler)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="70" y="90" width="300" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p5_r2" value="nextPickupAt ≤ PHARMACY_REFILL_LEAD_DAYS&#10;(3 hari) → buat request&#10;source=ROUTINE, status QUEUED langsung&#10;(resep sudah APPROVED)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="70" y="180" width="300" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p5_r3" value="SUMBER PATIENT_REQUEST — mobile&#10;(tab Request Obat)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="70" y="310" width="300" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p5_r4" value="Pasien ajukan: jumlah + alasan&#10;(EARLY_PICKUP / LOST / DAMAGED /&#10;EXTRA / OTHER) · patientId dari JWT" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="70" y="400" width="300" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p5_r5" value="Resep APPROVED &amp; aktif&#10;dan qty ≤ 90 hari?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="100" y="510" width="240" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p5_r5n" value="TOLAK — 422/400&#10;(resep tidak valid / qty melebihi batas)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="70" y="640" width="300" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p5_r6" value="Status: PENDING_DOCTOR&#10;menunggu keputusan dokter" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="70" y="730" width="300" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p5_d1" value="Dokter/Bidan review di /requests&#10;PATCH /v1/medication-requests/:id/decision" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="470" y="510" width="240" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p5_d2" value="Keputusan?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="490" y="630" width="200" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p5_d3" value="APPROVED (qty parsial opsional)&#10;→ status QUEUED&#10;WA ke pasien + keluarga aktif" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="470" y="750" width="240" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p5_d4" value="REJECTED — catatan wajib&#10;WA ke pasien + alasan" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="470" y="880" width="240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p5_fq" value="QUEUED&#10;(antrean apotek)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="810" y="510" width="240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p5_f1" value="START_PREPARING → PREPARING&#10;(Farmasi menyiapkan obat)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="810" y="610" width="240" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p5_f2" value="MARK_READY → READY&#10;WA: &#39;obat siap diambil&#39; ke pasien + keluarga" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="810" y="710" width="240" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p5_f3" value="Ada masalah stok / substitusi?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="820" y="830" width="220" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p5_f4" value="DISPENSED&#10;(wajib isi quantityDays)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="810" y="970" width="240" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p5_f5" value="SELESAI ✓&#10;buat DispensingRecord&#10;stok quantityRemaining −&#10;medication.nextPickupAt +" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="810" y="1080" width="240" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p5_foos" value="MARK_OUT_OF_STOCK (alasan wajib)&#10;→ OUT_OF_STOCK (final)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1100" y="830" width="240" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p5_fsub" value="MARK_SUBSTITUTED (alasan + nama obat)&#10;→ SUBSTITUTED&#10;dokter wajib setujui substitusi nanti" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1100" y="930" width="240" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p5_note" value="Pasien memantau status di tab&#10;My Requests (isOverdue = turunan, bukan status tersimpan).&#10;RBAC: FARMASI hanya boleh menyentuh /medication-requests* dan&#10;/dispensing-records — tidak bisa meresep/menyetujui." style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=4;" vertex="1" parent="1">
          <mxGeometry x="810" y="1190" width="330" height="90" as="geometry" />
