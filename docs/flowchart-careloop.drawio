        </mxCell>
        <mxCell id="p6_g1" value="ALUR NAKES — /dashboard (Next.js + Socket.IO)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#666666;dashed=1;verticalAlign=top;fontStyle=1;align=center;" vertex="1" parent="1">
