  <diagram id="careloop-auth" name="2. Auth &amp; Onboarding">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p2_title" value="CareLoop — Alur Autentikasi &amp; Onboarding Pasien" style="text;html=1;fontSize=20;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="280" y="20" width="560" height="30" as="geometry" />
        </mxCell>
        <mxCell id="p2_g1" value="PASIEN / KELUARGA — OTP via WhatsApp" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#666666;dashed=1;verticalAlign=top;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="40" y="70" width="380" height="600" as="geometry" />
        </mxCell>
        <mxCell id="p2_g2" value="NAKES / ADMIN — Password" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#666666;dashed=1;verticalAlign=top;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="460" y="70" width="380" height="640" as="geometry" />
        </mxCell>
        <mxCell id="p2_g3" value="AKTIVASI PASIEN (oleh nakes)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#666666;dashed=1;verticalAlign=top;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="880" y="70" width="300" height="800" as="geometry" />
        </mxCell>
        <mxCell id="p2_start" value="START&#10;User membuka aplikasi" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="500" y="110" width="200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p2_dec" value="Peran?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="530" y="190" width="140" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p2_p1" value="Masukkan no. HP&#10;POST /v1/auth/otp/request&#10;(rate limit 1/30s · respons identik&#10;untuk nomor terdaftar/tidak)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="70" y="300" width="280" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p2_p2" value="OTP dikirim via WhatsApp&#10;(TTL 300s · mock = 123456)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="70" y="410" width="280" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p2_p3" value="POST /v1/auth/otp/verify&#10;(maks 5 percobaan · kode 1× pakai)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="70" y="500" width="280" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p2_p4" value="BERHASIL — JWT 24 jam&#10;disimpan di expo-secure-store" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="70" y="590" width="280" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p2_n1" value="POST /v1/auth/login&#10;telepon/email + password (bcrypt cost 12)&#10;JWT claims: sub, role, nakesRole" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="490" y="300" width="280" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p2_n2" value="BERHASIL — masuk /dashboard&#10;(scope: puskesmas/district assignments)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="490" y="410" width="280" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p2_n3" value="Admin: POST /v1/admin/nakes-accounts&#10;→ status INVITED + kode aktivasi 1×&#10;(hash · TTL 7 hari)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="490" y="500" width="280" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p2_n4" value="Staf: POST /v1/auth/activate&#10;(kode + password baru) → ACTIVE" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="490" y="610" width="280" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p2_r1" value="Nakes mendaftarkan pasien&#10;POST /v1/patients → status ONBOARDING&#10;(user PATIENT tanpa password — hanya OTP)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="900" y="300" width="260" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p2_r2" value="Checklist aktivasi lengkap?&#10;PUSKESMAS · CONSENT · WA TERVERIFKASI&#10;MINIMUM_DATA · KONTAK ESKALASI&#10;RESEP APPROVED · JADWAL AKTIF" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="910" y="410" width="240" height="120" as="geometry" />
        </mxCell>
        <mxCell id="p2_r3" value="Lengkapi lewat work queue&#10;di /dashboard (bucket INCOMPLETE,&#10;UNVERIFIED, NO_ESCALATION_CONTACT, ...)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="900" y="560" width="260" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p2_r4" value="POST /v1/patients/:id/activate&#10;(DOKTER/BIDAN/ADMIN)&#10;→ status ACTIVE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="900" y="660" width="260" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p2_r5" value="Hanya pasien ACTIVE yang masuk&#10;loop reminder &amp; eskalasi (lihat hal. 3)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="900" y="760" width="260" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p2_e1" value="Pasien / Keluarga" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="p2_dec" target="p2_p1">
