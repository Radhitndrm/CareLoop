          <mxGeometry x="400" y="290" width="160" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p6_a1" value="Grafik kepatuhan GET /dashboard/adherence&#10;(harian + per penyakit)&#10;filter: distrik · penyakit · rentang tanggal · status eskalasi" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="250" y="410" width="460" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p6_a2" value="Alert real-time (Socket.IO) + /dashboard/alerts&#10;events: emergency.priority · escalation.step ·&#10;compliance.updated · risk.updated — room per nakes/puskesmas/distrik" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="250" y="520" width="460" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p6_a3" value="Work queue GET /dashboard/work-queue&#10;bucket: INCOMPLETE · UNVERIFIED · NO_ESCALATION_CONTACT ·&#10;NO_APPROVED_MEDICATION · NO_ACTIVE_SCHEDULE ·&#10;ACTIVE_ESCALATION · OPEN_EMERGENCY" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="250" y="640" width="460" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p6_a4" value="Kelola pasien (/patients):&#10;daftar pasien baru → buat resep DRAFT →&#10;APPROVED (DOKTER/BIDAN) → buat jadwal →&#10;ceklist aktivasi → ACTIVE" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
