        </mxCell>
        <mxCell id="p6_s1" value="START — Login /login&#10;(telepon/email + password → JWT)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="330" y="90" width="300" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p6_s2" value="GET /v1/dashboard/summary&#10;total pasien · tingkat kepatuhan ·&#10;darurat/escalation aktif · jumlah berisiko" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
