{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "NODE_ENV",
    "PORT",
    "DATABASE_URL",
    "DIRECT_URL",
    "TEST_DATABASE_URL",
    "REDIS_URL",
    "JWT_SECRET",
    "JWT_EXPIRES_IN",
    "PROVIDER_MODE",
    "OTP_MOCK_CODE",
    "OTP_TTL_SEC",
    "OTP_RESEND_COOLDOWN_SEC",
    "OTP_MAX_ATTEMPTS",
    "WA_WEBHOOK_VERIFY_TOKEN",
    "CORS_ORIGINS",
    "QUEUE_DISABLE_REDIS"
  ],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "lint": {},
    "typecheck": {},
    "test": {
      "dependsOn": ["^build"]
    }
  }
}